{
  "name": "sindarin-lang",
  "publisher": "sindarincorp",
  "author": "Guilherme Oliveira Siqueira",
  "displayName": "Sindarin for VSCode",
  "icon": "resources/Sindarin128pxColor.png",
  "license": "MIT",
  "description": "Extension for Sindarin, a program for crystal diffraction calculations",
  "repository": {
    "type": "git",
    "url": "https://github.com/guilhermeolisi/sindarin-for-vscode.git"
  },
  "version": "0.3.0",
  "engines": {
    "vscode": "^1.85.0"
  },
  "keywords": [
    "sindarin",
    "x-ray",
    "diffraction",
    "crystal",
    "crystallography",
    "rietveld",
    "refinement"
  ],
  "categories": [
    "Other",
    "Programming Languages",
    "Extension Packs"
  ],
  "activationEvents": [
    "onLanguage:sindarin"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "configuration": {
      "title": "Sindarin",
      "properties": {
        "sindarin.executablePath": {
          "type": "string",
          "default": "",
          "markdownDescription": "Absolute path to the Sindarin executable (or `Sindarin.dll` on macOS). Supports a leading `~` for the home directory. When empty, the extension looks for `Sindarin` on the system PATH and then in the default folder (`C:\\Sindarin` on Windows, `~/Sindarin` otherwise)."
        }
      }
    },
    "keybindings": [
      {
        "command": "sindarin-lang.interpret",
        "key": "ctrl+shift+down",
        "when": "editorLangId == sindarin"
      },
      {
        "command": "sindarin-lang.walk",
        "key": "ctrl+shift+right",
        "when": "editorLangId == sindarin"
      },
      {
        "command": "sindarin-lang.update",
        "key": "ctrl+shift+u"
      },
      {
        "command": "sindarin-lang.manual",
        "key": "ctrl+shift+m"
      }
    ],
    "commands": [
      {
        "command": "sindarin-lang.interpret",
        "title": "Interpret",
        "category": "Sindarin",
        "icon": "resources/commandInterpret16pxmono.png"
      },
      {
        "command": "sindarin-lang.walk",
        "title": "Walk",
        "category": "Sindarin",
        "icon": "resources/commandWalk16pxmono.png"
      },
      {
        "command": "sindarin-lang.update",
        "title": "Update",
        "category": "Sindarin",
        "icon": "resources/commandUpdate16pxmono.png"
      },
      {
        "command": "sindarin-lang.manual",
        "title": "Manual",
        "category": "Sindarin",
        "icon": "resources/commandManual16pxmono.png"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "sindarin-lang.interpret",
          "group": "navigation",
          "when": "editorLangId == sindarin"
        },
        {
          "command": "sindarin-lang.walk",
          "group": "navigation",
          "when": "editorLangId == sindarin"
        },
        {
          "command": "sindarin-lang.update",
          "group": "navigation",
          "when": "editorLangId == sindarin"
        },
        {
          "command": "sindarin-lang.manual",
          "group": "navigation",
          "when": "editorLangId == sindarin"
        }
      ]
    },
    "languages": [
      {
        "id": "sindarin",
        "extensions": [
          ".sin"
        ],
        "aliases": [
          "Sindarin",
          "sin"
        ],
        "configuration": "./grammar/language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "sindarin",
        "path": "./grammar/syntaxes/sindarin.tmLanguage.json",
        "scopeName": "source.sin"
      }
    ]
  },
  "extensionPack": [
    "RandomFractalsInc.vscode-chartjs"
  ],
  "scripts": {
    "vscode:prepublish": "npm run package",
    "compile": "npm run check-types && npm run lint && node esbuild.js",
    "watch": "node esbuild.js --watch",
    "package": "npm run check-types && npm run lint && node esbuild.js --production",
    "check-types": "tsc --noEmit",
    "lint": "eslint src",
    "compile-tests": "tsc -p . --outDir out",
    "pretest": "npm run compile-tests && npm run compile",
    "test": "vscode-test",
    "package-vsix": "vsce package -o sindarin-lang.vsix",
    "publish:vsce": "vsce publish -i sindarin-lang.vsix"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@types/mocha": "^10.0.10",
    "@types/node": "^22.10.5",
    "@types/vscode": "^1.85.0",
    "@vscode/test-cli": "^0.0.10",
    "@vscode/test-electron": "^2.4.1",
    "@vscode/vsce": "^3.2.1",
    "esbuild": "^0.28.0",
    "eslint": "^9.17.0",
    "mocha": "^10.8.2",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.19.0"
  }
}
